{
  "name": "zemirot-studio",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "A calm, fast interface for the Zemirot Database with search, five transliteration styles, and filters.",
  "author": "Zemirot Studio",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:update",
    "build:update": "node scripts/build-update-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:cache": "tsx scripts/scrape.ts --offline",
    "check:updates": "tsx scripts/check-updates.ts",
    "import:baqashot": "tsx scripts/import-baqashot.ts",
    "desktop": "npm run build && electron .",
    "art:installer": "electron scripts/installer-art/main.cjs",
    "download-page": "node scripts/serve-download.mjs",
    "package:win": "npm run build && npm run art:installer && electron-builder --win nsis --x64 --publish never",
    "check:signature": "node scripts/check-signature.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "cheerio": "^1.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "build": {
    "appId": "com.zemirot.studio",
    "productName": "Zemirot Studio",
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Zemirot-Studio-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zemirot Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "en_US"
      ],
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Zemirot Studio ${version}"
    }
  }
}
